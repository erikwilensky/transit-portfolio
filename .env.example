# Settings for docker-compose.yml. Copy to .env (scripts/deploy-mac.sh does this the first time).
# .env is not committed. Every line here also reaches the server as an environment variable.

# demo: persona switcher, tours and reset, no sign-in.  pilot: sign-in, each person sees their own role.
TP_MODE=demo

# Also run the real pilot on host port 8081, with its own data folder (TP_PILOT_DATA).
#COMPOSE_PROFILES=pilot

# How a pilot with no saved record yet begins. empty (the pilot service's default): the school's lines and
# no fictional people, stations or drafts; import the class lists from Accounts. seed: the demo's record.
# Only read in pilot mode, and only when the data folder has no state.json.
#TP_START=empty

# Where the data lives, relative to the repo folder. Keep these outside the repo.
#TP_DATA=../transit-portfolio-data
#TP_PILOT_DATA=../transit-pilot-data

# 127.0.0.1 (default): only this Mac (cloudflared) can reach the ports. 0.0.0.0: the local network too.
#TP_BIND=127.0.0.1

# Which peers may set X-Forwarded-For / X-Forwarded-Proto / CF-Connecting-IP: auto (private and
# loopback addresses, the default), all, or none.
#TRUST_PROXY=auto

# One log line per /api request (no bodies, no query strings). 0 turns it off.
#LOG_REQUESTS=1

# Failed sign-ins one address may make in 15 minutes (a whole school can share one address).
#AUTH_IP_LIMIT=300

# Optional email for setup and forgot-password links. Without these, admins and advisors hand out links.
#SMTP_URL=smtp://user%40school.ac.th:password@smtp.example.org:587
#MAIL_FROM=Transit Portfolio <noreply@school.ac.th>
